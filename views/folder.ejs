<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= locals.folderName</title>
  </head>
  <body>
    <% if (locals.user) {%>
        <div class="folders">
          <h2>Folders</h2>
          <form action="/create-folder" method="POST">
            <button type="submit">Create New Folder</button>
          </form>
          <ul>
            <% locals.folders.forEach(folder => {%>
              <li>
                <a href="/folder/<%=folder.id%>"><%= folder.folderName%></a></li>
                <form action="/delete-folder/<%=folder.id%>" method="POST">
                  <button type="submit" onclick="return confirm('Are you sure you want to delete this folder?');">Delete Folder</button>
                </form>
              </li>
             <%})%>
          </ul>
        </div>
        <div class="files">
          <h2>Files</h2>
          <ul>
            
          </ul>
        </div>
    <%} else (!locals.user){%>
      <h2>Please log in.</h2>
      <a href="log-in">Log in</a>
    <%}%>
  </body>
</html>
