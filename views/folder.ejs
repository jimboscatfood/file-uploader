<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= locals.folder.name%></title>
  </head>
  <body>
    <!-- verifying that the folder belongs to its user -->
    <% if (locals.user.id === folder.userId) {%>
    <h1><%= user.username%>'s File Storage</h1>
    <%- include("./partials/errors.ejs")%>
    <h1><%= folder.name%></h1>
    <h2>Folders</h2>
    <form action="/folder/<%=folder.id%>/new-folder" method="GET">
        <button type="submit">New Folder</button>
    </form>
    <ul>
    <% if (!folder.subFolders || folder.subFolders.length === 0){%>
      <h3>No Folders</h3>
    <%} else {folder.subFolders.forEach(folder => {%>
      <li><a href="/folder/<%=folder.id%>"><%= folder.name%></a>
      <form action="/delete/<%=folder.id%>" method="POST">
        <button type="submit" onclick="return confirm('Are you sure you want to delete this folder?');">Delete Folder</button>
      </form>
      </li>
    <%})}%>
    </ul>
    <h2>Files</h2>
    <form action="/folder/<%=folder.id%>/upload" method="POST" enctype="multipart/form-data">
        <label for="file">Choose Your File: </label><input type="file" name="upload"/>
        <button type="submit">Upload</button>
      </form>
    <ul>
      <%if (!folder.file || folder.file.length === 0) {%>
        <h3>No Files</h3>
      <%} else {folder.file.forEach(file => {%>
      <li><a href="/file/<%=file.id%>"><%=file.name%></a></li>
      <%})}%>
    </ul>
    <% if (user.folders[0].id === folder.parentId) {%>
    <form action="/" method="GET">
      <button type="submit">Previous Folder</button>
    </form>
    <%}  else {%>
    <form action="/folder/<%=folder.parentId%>" method="GET">
      <button type="submit">Previous Folder</button>
    </form>
    <% }%>
    <form action="/" method="GET">
      <button type="submit">Back to Home</button>
    </form>
    <form action="/log-out" method="GET">
      <button type="submit">Log Out</button>
    </form>
    <%} else {%> 
    <form action="/sign-up" method="GET">
      <button type="submit">Sign Up</button>
    </form>
    <form action="/log-in" method="GET">
      <button type="submit">Log In</button>
    </form>
    <%}%>
  </body>
</html>
